  <script>
    // プログラム名に「肯定側」「否定側」が含まれる行を自動で色分け
    document.querySelectorAll("tbody tr").forEach((row) => {
      const programCell = row.cells[1];
      if (!programCell) return;

      const program = programCell.textContent;

      if (program.includes("肯定側")) {
        row.classList.add("affirmative-row");
      } else if (program.includes("否定側")) {
        row.classList.add("negative-row");
      }
    });
