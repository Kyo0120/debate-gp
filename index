<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>大会スケジュール</title>

  <style>
    :root {
      --navy: #17324d;
      --blue: #2864a5;
      --line: #d9e2ec;
      --text: #253449;
      --muted: #68788a;
      --accent: #e8a33a;

      --affirmative-bg: #edf5ff;
      --affirmative-accent: #2878c7;
      --negative-bg: #fff0f0;
      --negative-accent: #d9534f;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 32px 18px;
      background: #f4f7fa;
      color: var(--text);
      font-family:
        -apple-system, BlinkMacSystemFont, "Segoe UI",
        "Noto Sans JP", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
    }

    main {
      max-width: 900px;
      margin: 0 auto;
    }

    header {
      margin-bottom: 18px;
      padding: 32px;
      border-radius: 18px;
      color: #fff;
      background: linear-gradient(135deg, var(--navy), var(--blue));
      box-shadow: 0 8px 24px #17324d22;
    }

    header .label {
      margin: 0 0 8px;
      color: #d7e8fa;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    h1 {
      margin: 0;
      font-size: clamp(1.8rem, 5vw, 2.5rem);
    }

    header .summary {
      margin: 12px 0 0;
      color: #e6eff8;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin: 0 0 18px;
      padding: 12px 16px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
      color: var(--text);
      font-size: 0.9rem;
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .legend-swatch {
      width: 18px;
      height: 18px;
      border-radius: 4px;
    }

    .legend-swatch.affirmative {
      border-left: 4px solid var(--affirmative-accent);
      background: var(--affirmative-bg);
    }

    .legend-swatch.negative {
      border-left: 4px solid var(--negative-accent);
      background: var(--negative-bg);
    }

    .schedule-section {
      margin: 22px 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 4px 14px #17324d0a;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 17px 22px;
      color: #fff;
      background: var(--navy);
    }

    .section-heading h2 {
      margin: 0;
      font-size: 1.2rem;
    }

    .section-heading span {
      color: #d7e8fa;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 12px 22px;
      border-bottom: 1px solid var(--line);
      text-align: left;
    }

    th {
      color: var(--muted);
      background: #f8fafc;
      font-size: 0.82rem;
      font-weight: 700;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    td.time {
      width: 180px;
      color: var(--blue);
      font-variant-numeric: tabular-nums;
      font-weight: 750;
      white-space: nowrap;
    }

    td.duration {
      width: 100px;
      color: var(--muted);
      text-align: right;
      white-space: nowrap;
    }

    /* 肯定側：青 */
    tr.affirmative-row td {
      background: var(--affirmative-bg);
    }

    tr.affirmative-row td:first-child {
      box-shadow: inset 4px 0 var(--affirmative-accent);
    }

    /* 否定側：赤 */
    tr.negative-row td {
      background: var(--negative-bg);
    }

    tr.negative-row td:first-child {
      box-shadow: inset 4px 0 var(--negative-accent);
    }

    /* 休憩 */
    tr.break-row td {
      background: #fffaf0;
    }

    tr.break-row td:first-child {
      box-shadow: inset 4px 0 var(--accent);
    }

    /* オープニング・表彰など */
    tr.opening-row td {
      background: #eef5fc;
    }

    tr.final-row td {
      background: #f5f2fc;
    }

    footer {
      margin: 24px 0 8px;
      color: var(--muted);
      font-size: 0.85rem;
      text-align: center;
    }

    @media (max-width: 560px) {
      body {
        padding: 18px 10px;
      }

      header {
        padding: 24px 20px;
      }

      th,
      td {
        padding: 11px 12px;
      }

      td.time {
        width: auto;
        font-size: 0.9rem;
      }

      td.duration {
        width: auto;
      }

      .section-heading {
        padding: 15px 14px;
      }
    }

    @media print {
      body {
        padding: 0;
        background: #fff;
      }

      header,
      .schedule-section {
        box-shadow: none;
      }

      header {
        border-radius: 0;
      }

      .schedule-section {
        break-inside: avoid;
      }

      .section-heading,
      tr.affirmative-row td,
      tr.negative-row td,
      tr.break-row td,
      tr.opening-row td,
      tr.final-row td {
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }
    }
  </style>
</head>

